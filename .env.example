# 키 없이 구조만 공유하는 예시 파일
GEMINI_API_KEY=
# RAG_MODEL=gemini-3.5-flash,gemini-3.8-flash

# 정적 사이트 단독(Standalone) 배포 — 브라우저에서 Gemini 직접 호출. 빌드 시 JS 번들에 포함되어 공개되므로
# Google Cloud 콘솔에서 키를 배포 도메인(HTTP 리퍼러)·Generative Language API 로 제한할 것.
# 빌드 환경변수 gemini_API 가 있으면 그것을 먼저 쓴다 (Render 설정 이름, vite.config.ts define). 대체 이름: VITE_gemini_API
VITE_GEMINI_API_KEY=
